# Copy to backend/.env and fill in. Every value is optional except the admin key,
# without which the admin API stays disabled.

TANDO_DATABASE_URL=sqlite:///./tomandollie.db
TANDO_ADMIN_API_KEY=

# Front-end origins allowed to call the API.
TANDO_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Fulfilment. Dispatch weekdays are 0=Monday. Chilled parcels must not sit in
# transit over a weekend, so Mon-Wed is the default.
TANDO_DISPATCH_WEEKDAYS=0,1,2
TANDO_DISPATCH_CUTOFF_HOUR=12
TANDO_CHILLED_TRANSIT_DAYS=1
TANDO_AMBIENT_TRANSIT_DAYS=2
TANDO_DELIVERY_WINDOW_DAYS=60

# Set to 0 to switch free delivery off.
TANDO_FREE_DELIVERY_THRESHOLD_PENCE=6000
